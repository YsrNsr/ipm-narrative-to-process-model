# Fournisseur LLM actif : ollama | openai | anthropic
PROVIDER=ollama

# Ollama (local, open-source) : confidentialite, conforme nLPD
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral
# OLLAMA_NUM_GPU=0 force le CPU (GPU avec trop peu de VRAM ou instable)
OLLAMA_NUM_GPU=
# Fenetre de contexte (defaut 8192) : augmenter pour les transcriptions longues
OLLAMA_NUM_CTX=8192

# OpenAI (cloud)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (cloud)
ANTHROPIC_API_KEY=
# Defaut : Opus de la generation courante — plus capable, mais plus
# lent et plus cher par generation. Alternative economique eprouvee :
# claude-sonnet-4-6. Les chiffres archives du banc (annexe C) restent
# attaches au modele avec lequel ils ont ete mesures ; pour comparer,
# rejouer le banc (le cache est deja indexe par modele).
ANTHROPIC_MODEL=claude-opus-5

# Delai fournisseur en millisecondes (defaut 30 min)
LLM_TIMEOUT_MS=

# Serveur web
PORT=3000

# Jeton d'acces (deploiement partage). Vide : outil de poste local,
# aucune authentification. Defini : toutes les routes /api/* exigent
# ce jeton (en-tete X-Auth-Token ou Authorization: Bearer).
AUTH_TOKEN=

# Listes de modeles proposees dans l'interface (noms separes par des
# virgules) ; a defaut, les identifiants eprouves du code sont proposes
ANTHROPIC_MODELS=
OPENAI_MODELS=
# Budget de sortie Anthropic (le raisonnement adaptatif d'Opus compte dedans)
ANTHROPIC_MAX_TOKENS=16000
