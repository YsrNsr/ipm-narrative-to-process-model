<?xml version="1.0" encoding="UTF-8"?>
<!--
  Exporte par Agent MIP depuis le modele intermediaire de processus (JSON).
  Transpose fidelement : acteurs (lanes), etapes (taches ; service tasks si
  automatisees), decisions (passerelles exclusives, flux oui/non, retours),
  parallelisme d'etage (paire de passerelles paralleles AND split/join),
  declencheur (start event), chaque terminaison du flux (end events etiquetes),
  exceptions rattachees a une etape (annotations associees a leur tache),
  couleurs par type d'element (extension bioc, affichee par bpmn.io/Camunda).
  Degrade (sans equivalent BPMN direct) : documents, donnees, outils, durees,
  volumes, frequences, frictions, opportunites, regles metier, exceptions non
  rattachees et incertitudes -> documentation des elements concernes ; les
  decisions restent strictement binaires (le MIP l'est par construction) ;
  pas d'evenement intermediaire ni de message flow ; les marquages de valeurs
  deduites ne sont pas transposes.
-->
