        <object id="proc-card_0" label="Consulter le planning mensuel" tooltip="Mode opératoire : La table recue sur le site web indique quel jour on travaille et de quelle heure a quelle heure" source="Mode opératoire : La table recue sur le site web indique quel jour on travaille et de quelle heure a quelle heure"><mxCell parent="proc-cell_0_0" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_1" label="Arriver sur site" tooltip="Durée : 15 minutes avant le debut du shift" source="Durée : 15 minutes avant le debut du shift"><mxCell parent="proc-cell_0_1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_2" label="Consulter son affectation au vol" tooltip="Mode opératoire : Des ecrans poses un peu partout dans la salle d'attente indiquent pour chaque personne sur quel vol elle va partir ; une personne est egalement a l'accueil" source="Mode opératoire : Des ecrans poses un peu partout dans la salle d'attente indiquent pour chaque personne sur quel vol elle va partir ; une personne est egalement a l'accueil"><mxCell parent="proc-cell_0_2" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_3" label="Conduire l'equipe jusqu'a l'avion" tooltip="Mode opératoire : Le chef d'equipe attend l'equipe et tout le monde part ensemble dans la navette" source="Mode opératoire : Le chef d'equipe attend l'equipe et tout le monde part ensemble dans la navette"><mxCell parent="proc-cell_2_3" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="30" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_4" label="Obtenir l'autorisation de commencer" tooltip="Mode opératoire : Une fois devant l'avion, le chef d'equipe parle a la personne de la radio qui lui dit quand il pourra commencer les differentes etapes" source="Mode opératoire : Une fois devant l'avion, le chef d'equipe parle a la personne de la radio qui lui dit quand il pourra commencer les differentes etapes"><mxCell parent="proc-cell_1_4" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="46" width="199" x="20" y="2" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-dec_4" label="Autorisation donnee ?" tooltip="Autorisation donnee ?" source="Autorisation donnee ?"><mxCell parent="proc-cell_1_4" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;fontSize=8;" vertex="1"><mxGeometry height="70" width="70" x="80" y="54" as="geometry"></mxGeometry></mxCell></object>
        <mxCell id="proc-declink_4" parent="proc-L0" style="html=1;endArrow=block;endFill=1;strokeColor=#8A6D00;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="" edge="1" source="proc-card_4" target="proc-dec_4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <object id="proc-card_5" label="Mettre les cales" tooltip="Mode opératoire : Poser les cales devant les roues pour que l'avion ne bouge pas" source="Mode opératoire : Poser les cales devant les roues pour que l'avion ne bouge pas"><mxCell parent="proc-cell_0_5" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="10" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_6" label="Brancher le chargeur electrique" tooltip="Mode opératoire : Mettre le chargeur pour charger l'electricite de l'avion, au tout debut des operations" source="Mode opératoire : Mettre le chargeur pour charger l'electricite de l'avion, au tout debut des operations"><mxCell parent="proc-cell_0_5" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="74" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_7" label="Positionner le tapis devant la soute" tooltip="Mode opératoire : Dans l'equipe, un bagagiste sait conduire le tapis qui monte et descend ; il l'amene jusqu'a la porte de l'avion ou l'on recupere les bagages" source="Mode opératoire : Dans l'equipe, un bagagiste sait conduire le tapis qui monte et descend ; il l'amene jusqu'a la porte de l'avion ou l'on recupere les bagages"><mxCell parent="proc-cell_0_6" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_8" label="Vider la soute" tooltip="Mode opératoire : Deux ou trois bagagistes entrent dans la soute et se font des passes jusqu'a celui qui est devant la porte, qui depose les bagages sur le tapis" source="Mode opératoire : Deux ou trois bagagistes entrent dans la soute et se font des passes jusqu'a celui qui est devant la porte, qui depose les bagages sur le tapis"><mxCell parent="proc-cell_0_7" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="10" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_9" label="Ranger les bagages sur les chariots" tooltip="Mode opératoire : Le bagagiste qui attend en bas du tapis ramene les chariots et range les bagages qui descendent" source="Mode opératoire : Le bagagiste qui attend en bas du tapis ramene les chariots et range les bagages qui descendent"><mxCell parent="proc-cell_0_7" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="74" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_10" label="Ramener les chariots au centre de tri" tooltip="Mode opératoire : Une fois la soute vide, un des bagagistes bouge tous les chariots du chemin et les ramene au centre de tri" source="Mode opératoire : Une fois la soute vide, un des bagagistes bouge tous les chariots du chemin et les ramene au centre de tri"><mxCell parent="proc-cell_0_8" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_11" label="Charger les bagages des passagers" tooltip="Mode opératoire : Pendant l'embarquement des prochains passagers, le bagagiste en bas pose les bagages sur le tapis et les bagagistes dans la soute les mettent l'un au-dessus de l'autre" source="Mode opératoire : Pendant l'embarquement des prochains passagers, le bagagiste en bas pose les bagages sur le tapis et les bagagistes dans la soute les mettent l'un au-dessus de l'autre"><mxCell parent="proc-cell_0_9" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="46" width="199" x="20" y="2" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-dec_11" label="Tous les passagers a bord ?" tooltip="Tous les passagers a bord ?" source="Tous les passagers a bord ?"><mxCell parent="proc-cell_0_9" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;fontSize=8;" vertex="1"><mxGeometry height="70" width="70" x="80" y="54" as="geometry"></mxGeometry></mxCell></object>
        <mxCell id="proc-declink_11" parent="proc-L0" style="html=1;endArrow=block;endFill=1;strokeColor=#8A6D00;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="" edge="1" source="proc-card_11" target="proc-dec_11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <object id="proc-card_12" label="Declarer la fin du chargement" tooltip="Mode opératoire : Le chef d'equipe guide toutes les operations, dit quoi faire et a quel moment, quand mettre les bagages et quand on a fini" source="Mode opératoire : Le chef d'equipe guide toutes les operations, dit quoi faire et a quel moment, quand mettre les bagages et quand on a fini"><mxCell parent="proc-cell_1_10" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_13" label="Enlever les cales et le chargeur" tooltip="Mode opératoire : On enleve les cales et le chargeur une fois que l'avion est pret a decoller et que les bagages sont mis" source="Mode opératoire : On enleve les cales et le chargeur une fois que l'avion est pret a decoller et que les bagages sont mis"><mxCell parent="proc-cell_0_11" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_14" label="Ramener l'equipe au centre d'accueil" tooltip="Mode opératoire : Egalement possible : si le prochain vol est proche en temps et en distance, l'equipe ne rentre pas au centre d'accueil et va directement a la prochaine station" source="Mode opératoire : Egalement possible : si le prochain vol est proche en temps et en distance, l'equipe ne rentre pas au centre d'accueil et va directement a la prochaine station"><mxCell parent="proc-cell_2_12" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="30" as="geometry"></mxGeometry></mxCell></object>
