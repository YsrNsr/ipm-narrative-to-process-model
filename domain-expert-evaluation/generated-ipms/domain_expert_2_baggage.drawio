        <object id="maki_rei_r7_val" label="≈ Passager qui ne part pas : revider tous les bagages jusqu'a retrouver le sien et le sortir de l'avion [étape 10]" tooltip="Aucune phrase du texte ne soutient cette valeur — a verifier." source="Aucune phrase du texte ne soutient cette valeur — a verifier."><mxCell parent="maki_rei_r7" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFFF;top=0;left=0;bottom=1;right=1;pointerEvents=1;fontFamily=Arial,Helvetica,sans-serif;fontSize=8;fontColor=#8A8F94;align=left;verticalAlign=middle;fontStyle=2;spacingLeft=6;" vertex="1"><mxGeometry height="26" width="3290" x="215" y="0" as="geometry"></mxGeometry></mxCell></object>
