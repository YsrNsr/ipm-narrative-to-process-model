        <mxCell id="bpmn-L0" parent="0" value="Processus" />
        <mxCell id="bpmn-note" parent="bpmn-L0" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#8A8F94;fontFamily=Arial,Helvetica,sans-serif;" value="Vue BPMN dérivée du MIP : parallélisme d'étage en passerelles ET, terminaisons et exceptions représentées ; décisions binaires ; la grille MIP reste la référence." vertex="1"><mxGeometry height="18" width="900" x="40" y="34" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-legend" parent="bpmn-L0" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#8A8F94;fontFamily=Arial,Helvetica,sans-serif;" value="Jaune : tâche humaine · Bleu : tâche automatisée · Vert : début · Rouge : fin · Orange : passerelle · Gris : annotation" vertex="1"><mxGeometry height="18" width="900" x="40" y="56" as="geometry"></mxGeometry></mxCell>
        <object id="bpmn-pool" label="Chargement et dechargement des bagages d'un avion" tooltip="Regle metier : Arriver sur site 15 minutes avant le debut du shift&#10;Regle metier : Le chef d'equipe parle a la personne de la radio qui lui dit quand il pourra commencer les differentes etapes&#10;Regle metier : Mettre les cales devant les roues au tout debut pour que l'avion ne bouge pas&#10;Regle metier : Mettre le chargeur pour charger l'electricite de l'avion au tout debut&#10;Regle metier : Si un passager a qui on a pose le bagage ne prend finalement pas l'avion, il faut revider les bagages jusqu'a trouver son bagage et l'enlever de l'avion pour des risques de securite&#10;Regle metier : Les cales et le chargeur ne sont enleves qu'une fois l'avion pret a decoller et les bagages mis&#10;Incertitude : « il y a deux ou trois bagagistes qui rentrent dans la soute »&#10;Incertitude : « il faut qu'ils s'en soient trois ou deux parce qu'il y a beaucoup de valises dans l'avion »&#10;Incertitude : « ils se font des passes, on va dire »&#10;Incertitude : « Si jamais notre prochain vol est pas loin en terme de temps et en terme de distance »"><mxCell parent="bpmn-L0" style="swimlane;html=1;childLayout=stackLayout;resizeParent=1;resizeParentMax=0;horizontal=0;startSize=24;horizontalStack=0;collapsible=0;fillColor=#F5F7F8;strokeColor=#67747C;fontColor=#2C3136;fontSize=11;fontStyle=1;" vertex="1"><mxGeometry height="512" width="3620" x="40" y="96" as="geometry"></mxGeometry></mxCell></object>
        <mxCell id="bpmn-lane_0" parent="bpmn-pool" style="swimlane;html=1;startSize=24;horizontal=0;collapsible=0;fillColor=none;strokeColor=#67747C;fontColor=#2C3136;fontSize=10;" value="Bagagiste" vertex="1"><mxGeometry height="232" width="3596" x="24" y="0" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-lane_1" parent="bpmn-pool" style="swimlane;html=1;startSize=24;horizontal=0;collapsible=0;fillColor=none;strokeColor=#67747C;fontColor=#2C3136;fontSize=10;" value="Chef d'equipe" vertex="1"><mxGeometry height="140" width="3596" x="24" y="232" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-lane_2" parent="bpmn-pool" style="swimlane;html=1;startSize=24;horizontal=0;collapsible=0;fillColor=none;strokeColor=#67747C;fontColor=#2C3136;fontSize=10;" value="Chauffeur" vertex="1"><mxGeometry height="140" width="3596" x="24" y="372" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-Start_1" parent="bpmn-lane_0" style="shape=mxgraph.bpmn.shape;html=1;perimeter=ellipsePerimeter;symbol=general;outline=standard;fillColor=#E4F2E9;strokeColor=#2F7D4F;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fontSize=9;fontColor=#2C3136;outlineConnect=0;whiteSpace=wrap;labelWidth=64;" value="Reception chaque mois du planning de travail sur le site web" vertex="1"><mxGeometry height="36" width="36" x="44" y="32" as="geometry"></mxGeometry></mxCell>
        <object id="bpmn-Task_s1" label="Consulter le planning mensuel" tooltip="Documents sortants : Table des jours et horaires de travail&#10;Donnees sortantes : Jour de travail, Heure de debut et de fin de shift&#10;Outils : Site Web&#10;Frequence : Chaque mois&#10;Mode operatoire : La table recue sur le site web indique quel jour on travaille et de quelle heure a quelle heure"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="96" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s2" label="Arriver sur site" tooltip="Donnees entrantes : Heure de debut de shift&#10;Duree : 15 minutes avant le debut du shift&#10;Frequence : A chaque shift"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="336" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s3" label="Consulter son affectation au vol" tooltip="Donnees sortantes : Vol affecte, Heure de depart&#10;Outils : Ecrans&#10;Frequence : A chaque vol&#10;Mode operatoire : Des ecrans poses un peu partout dans la salle d'attente indiquent pour chaque personne sur quel vol elle va partir ; une personne est egalement a l'accueil"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="576" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s4" label="Conduire l'equipe jusqu'a l'avion" tooltip="Donnees entrantes : Vol affecte&#10;Outils : Navette&#10;Frequence : A chaque vol&#10;Mode operatoire : Le chef d'equipe attend l'equipe et tout le monde part ensemble dans la navette&#10;Participants : Chef d'equipe, Bagagiste"><mxCell parent="bpmn-lane_2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="816" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s5" label="Obtenir l'autorisation de commencer" tooltip="Donnees sortantes : Moment de debut des operations&#10;Outils : Radio&#10;Frequence : A chaque vol&#10;Mode operatoire : Une fois devant l'avion, le chef d'equipe parle a la personne de la radio qui lui dit quand il pourra commencer les differentes etapes&#10;Participants : Personne de la radio"><mxCell parent="bpmn-lane_1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="1056" y="24" as="geometry"></mxGeometry></mxCell></object>
        <mxCell id="bpmn-Gw_s5" parent="bpmn-lane_1" style="shape=mxgraph.bpmn.shape;html=1;perimeter=rhombusPerimeter;background=gateway;outline=none;symbol=exclusiveGw;fillColor=#FFE6CC;strokeColor=#D79B00;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fontSize=9;fontColor=#2C3136;outlineConnect=0;" value="Autorisation donnee ?" vertex="1"><mxGeometry height="44" width="44" x="1230" y="28" as="geometry"></mxGeometry></mxCell>
        <object id="bpmn-Task_s6" label="Mettre les cales" tooltip="Outils : Cales&#10;Frequence : A chaque vol&#10;Mode operatoire : Poser les cales devant les roues pour que l'avion ne bouge pas"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="1296" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s7" label="Brancher le chargeur electrique" tooltip="Outils : Chargeur&#10;Frequence : A chaque vol&#10;Mode operatoire : Mettre le chargeur pour charger l'electricite de l'avion, au tout debut des operations"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="1296" y="116" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s8" label="Positionner le tapis devant la soute" tooltip="Outils : Tapis&#10;Frequence : A chaque vol&#10;Mode operatoire : Dans l'equipe, un bagagiste sait conduire le tapis qui monte et descend ; il l'amene jusqu'a la porte de l'avion ou l'on recupere les bagages"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="1536" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s9" label="Vider la soute" tooltip="Outils : Tapis&#10;Frequence : A chaque vol&#10;Friction : Nombre de valises — « il y a beaucoup de valises dans l'avion »&#10;Mode operatoire : Deux ou trois bagagistes entrent dans la soute et se font des passes jusqu'a celui qui est devant la porte, qui depose les bagages sur le tapis"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="1776" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s10" label="Ranger les bagages sur les chariots" tooltip="Outils : Tapis, Chariots&#10;Frequence : A chaque vol&#10;Mode operatoire : Le bagagiste qui attend en bas du tapis ramene les chariots et range les bagages qui descendent"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="1776" y="116" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s11" label="Ramener les chariots au centre de tri" tooltip="Outils : Chariots&#10;Frequence : A chaque vol&#10;Mode operatoire : Une fois la soute vide, un des bagagistes bouge tous les chariots du chemin et les ramene au centre de tri"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="2016" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s12" label="Charger les bagages des passagers" tooltip="Outils : Tapis&#10;Frequence : A chaque vol&#10;Friction : Bagage d'un passager qui ne part pas — « on doit revider tous les bagages jusqu'a qu'on trouve son bagage a lui et l'enlever de l'avion »&#10;Mode operatoire : Pendant l'embarquement des prochains passagers, le bagagiste en bas pose les bagages sur le tapis et les bagagistes dans la soute les mettent l'un au-dessus de l'autre"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="2256" y="24" as="geometry"></mxGeometry></mxCell></object>
        <mxCell id="bpmn-Gw_s12" parent="bpmn-lane_0" style="shape=mxgraph.bpmn.shape;html=1;perimeter=rhombusPerimeter;background=gateway;outline=none;symbol=exclusiveGw;fillColor=#FFE6CC;strokeColor=#D79B00;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fontSize=9;fontColor=#2C3136;outlineConnect=0;" value="Tous les passagers a bord ?" vertex="1"><mxGeometry height="44" width="44" x="2430" y="28" as="geometry"></mxGeometry></mxCell>
        <object id="bpmn-Task_s13" label="Declarer la fin du chargement" tooltip="Frequence : A chaque vol&#10;Mode operatoire : Le chef d'equipe guide toutes les operations, dit quoi faire et a quel moment, quand mettre les bagages et quand on a fini&#10;Participants : Bagagiste"><mxCell parent="bpmn-lane_1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="2496" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s14" label="Enlever les cales et le chargeur" tooltip="Outils : Cales, Chargeur&#10;Frequence : A chaque vol&#10;Mode operatoire : On enleve les cales et le chargeur une fois que l'avion est pret a decoller et que les bagages sont mis"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="2736" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s15" label="Ramener l'equipe au centre d'accueil" tooltip="Outils : Navette&#10;Frequence : A chaque vol&#10;Mode operatoire : Egalement possible : si le prochain vol est proche en temps et en distance, l'equipe ne rentre pas au centre d'accueil et va directement a la prochaine station&#10;Participants : Bagagiste, Chef d'equipe"><mxCell parent="bpmn-lane_2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="2976" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s16" label="Attendre le prochain vol" tooltip="Donnees entrantes : Vol suivant&#10;Outils : Ecrans&#10;Frequence : Entre chaque vol"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="3216" y="24" as="geometry"></mxGeometry></mxCell></object>
        <mxCell id="bpmn-GwSplit_c5" parent="bpmn-lane_0" style="shape=mxgraph.bpmn.shape;html=1;perimeter=rhombusPerimeter;background=gateway;outline=none;symbol=parallelGw;fillColor=#FFE6CC;strokeColor=#D79B00;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fontSize=9;fontColor=#2C3136;outlineConnect=0;" value="" vertex="1"><mxGeometry height="44" width="44" x="1240" y="28" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-GwJoin_c5" parent="bpmn-lane_0" style="shape=mxgraph.bpmn.shape;html=1;perimeter=rhombusPerimeter;background=gateway;outline=none;symbol=parallelGw;fillColor=#FFE6CC;strokeColor=#D79B00;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fontSize=9;fontColor=#2C3136;outlineConnect=0;" value="" vertex="1"><mxGeometry height="44" width="44" x="1524" y="28" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-GwSplit_c7" parent="bpmn-lane_0" style="shape=mxgraph.bpmn.shape;html=1;perimeter=rhombusPerimeter;background=gateway;outline=none;symbol=parallelGw;fillColor=#FFE6CC;strokeColor=#D79B00;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fontSize=9;fontColor=#2C3136;outlineConnect=0;" value="" vertex="1"><mxGeometry height="44" width="44" x="1720" y="28" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-GwJoin_c7" parent="bpmn-lane_0" style="shape=mxgraph.bpmn.shape;html=1;perimeter=rhombusPerimeter;background=gateway;outline=none;symbol=parallelGw;fillColor=#FFE6CC;strokeColor=#D79B00;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fontSize=9;fontColor=#2C3136;outlineConnect=0;" value="" vertex="1"><mxGeometry height="44" width="44" x="2004" y="28" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-End_main" parent="bpmn-lane_0" style="shape=mxgraph.bpmn.shape;html=1;perimeter=ellipsePerimeter;symbol=general;outline=end;fillColor=#FCE8E6;strokeColor=#B85450;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fontSize=9;fontColor=#2C3136;outlineConnect=0;whiteSpace=wrap;labelWidth=140;" value="Avion decharge, recharge et pret a decoller, equipe de retour au centre d'accueil en attente du vol suivant" vertex="1"><mxGeometry height="36" width="36" x="3498" y="124" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-Ann_0" parent="bpmn-lane_2" style="shape=note;html=1;whiteSpace=wrap;size=12;fillColor=#F5F5F5;strokeColor=#9AA0A6;fontColor=#57606A;fontFamily=Arial,Helvetica,sans-serif;fontSize=8;align=left;spacingLeft=4;" value="« Si jamais notre prochain vol est pas loin en terme de temps et en terme de distance, alors on ne rentre meme pas au centre d'accueil et on va directement a la prochaine station »" vertex="1"><mxGeometry height="30" width="150" x="2992" y="82" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-Ann_1" parent="bpmn-lane_0" style="shape=note;html=1;whiteSpace=wrap;size=12;fillColor=#F5F5F5;strokeColor=#9AA0A6;fontColor=#57606A;fontFamily=Arial,Helvetica,sans-serif;fontSize=8;align=left;spacingLeft=4;" value="Passager qui ne part pas : revider tous les bagages jusqu'a retrouver le sien et le sortir de l'avion" vertex="1"><mxGeometry height="30" width="150" x="1792" y="174" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-Assoc_0" parent="bpmn-L0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;dashed=1;strokeColor=#9AA0A6;strokeWidth=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="bpmn-Task_s15" target="bpmn-Ann_0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-Assoc_1" parent="bpmn-L0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;dashed=1;strokeColor=#9AA0A6;strokeWidth=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="bpmn-Task_s10" target="bpmn-Ann_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-Flow_1" parent="bpmn-L0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2C3136;strokeWidth=1.2;jettySize=auto;orthogonalLoop=1;fontSize=9;fontColor=#8A3B33;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="" edge="1" source="bpmn-Task_s1" target="bpmn-Task_s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-Flow_2" parent="bpmn-L0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2C3136;strokeWidth=1.2;jettySize=auto;orthogonalLoop=1;fontSize=9;fontColor=#8A3B33;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="" edge="1" source="bpmn-Task_s2" target="bpmn-Task_s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-Flow_3" parent="bpmn-L0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2C3136;strokeWidth=1.2;jettySize=auto;orthogonalLoop=1;fontSize=9;fontColor=#8A3B33;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="" edge="1" source="bpmn-Task_s3" target="bpmn-Task_s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-Flow_4" parent="bpmn-L0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2C3136;strokeWidth=1.2;jettySize=auto;orthogonalLoop=1;fontSize=9;fontColor=#8A3B33;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="" edge="1" source="bpmn-Task_s4" target="bpmn-Task_s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-Flow_5" parent="bpmn-L0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2C3136;strokeWidth=1.2;jettySize=auto;orthogonalLoop=1;fontSize=9;fontColor=#8A3B33;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="oui" edge="1" source="bpmn-Gw_s5" target="bpmn-GwSplit_c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-Flow_6" parent="bpmn-L0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2C3136;strokeWidth=1.2;jettySize=auto;orthogonalLoop=1;fontSize=9;fontColor=#8A3B33;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="" edge="1" source="bpmn-GwJoin_c5" target="bpmn-Task_s8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
