        <object id="proc-card_0" label="Choisir le niveau et la filière d'inscription" tooltip="Mode opératoire : Choisir d'abord entre master et bachelor, puis dans quel master ou quel bachelor s'inscrire" source="Mode opératoire : Choisir d'abord entre master et bachelor, puis dans quel master ou quel bachelor s'inscrire"><mxCell parent="proc-cell_0_0" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_1" label="Orienter l'étudiant" tooltip="Mode opératoire : Guider l'étudiant en fonction de ce qu'il aime, de ce qu'il n'aime pas et des débouchés qu'il espère" source="Mode opératoire : Guider l'étudiant en fonction de ce qu'il aime, de ce qu'il n'aime pas et des débouchés qu'il espère"><mxCell parent="proc-cell_1_1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="30" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_2" label="Choisir son orientation" tooltip="Mode opératoire : Orientation interdisciplinaire retenue ; également possibles : orientation économie et management, orientation art, orientation langue" source="Mode opératoire : Orientation interdisciplinaire retenue ; également possibles : orientation économie et management, orientation art, orientation langue"><mxCell parent="proc-cell_0_2" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_3" label="Choisir ses cours" tooltip="Mode opératoire : En orientation interdisciplinaire, choisir des cours dans toutes les facultés tant que le nombre de crédits est rempli" source="Mode opératoire : En orientation interdisciplinaire, choisir des cours dans toutes les facultés tant que le nombre de crédits est rempli"><mxCell parent="proc-cell_0_3" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_4" label="S'inscrire aux cours sur la plateforme" tooltip="Mode opératoire : S'inscrire sur la plateforme puis parler au professeur" source="Mode opératoire : S'inscrire sur la plateforme puis parler au professeur"><mxCell parent="proc-cell_0_4" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_5" label="Suivre les cours et rendre les travaux" tooltip="Mode opératoire : Suivre les cours, rendre les exercices demandés et effectuer les travaux notés" source="Mode opératoire : Suivre les cours, rendre les exercices demandés et effectuer les travaux notés"><mxCell parent="proc-cell_0_5" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
