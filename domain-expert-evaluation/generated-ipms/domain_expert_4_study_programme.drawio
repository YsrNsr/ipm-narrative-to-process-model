  <diagram id="bpmn" name="BPMN">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3940" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="bpmn-L0" parent="0" value="Processus" />
        <mxCell id="bpmn-note" parent="bpmn-L0" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#8A8F94;fontFamily=Arial,Helvetica,sans-serif;" value="Vue BPMN dérivée du MIP : parallélisme d'étage en passerelles ET, terminaisons et exceptions représentées ; décisions binaires ; la grille MIP reste la référence." vertex="1"><mxGeometry height="18" width="900" x="40" y="34" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-legend" parent="bpmn-L0" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#8A8F94;fontFamily=Arial,Helvetica,sans-serif;" value="Jaune : tâche humaine · Bleu : tâche automatisée · Vert : début · Rouge : fin · Orange : passerelle · Gris : annotation" vertex="1"><mxGeometry height="18" width="900" x="40" y="56" as="geometry"></mxGeometry></mxCell>
        <object id="bpmn-pool" label="Parcours d'études en systèmes d'information à l'université" tooltip="Regle metier : Il faut d'abord choisir si on s'inscrit en master ou en bachelor, puis dans quel master ou quel bachelor&#10;Regle metier : En orientation interdisciplinaire, on peut choisir des cours dans toutes les facultés tant que cela remplit le nombre de crédits possibles&#10;Regle metier : Il faut réussir la session de rattrapage : en cas de second échec sur un cours obligatoire, l'étudiant est éliminé du bachelor&#10;Regle metier : Si le cours n'est pas obligatoire, l'étudiant a encore deux autres tentatives&#10;Regle metier : À la fin de la troisième année, il faut parler au professeur et décider d'un sujet de travail de bachelor&#10;Regle metier : Pour faire un stage, il faut que la directrice de stage de l'université accepte le stage, qu'on trouve un encadrant académique et un encadrement en entreprise&#10;Regle metier : Le stage donne droit à des crédits&#10;Regle metier : En master, il n'y a pas d'orientation interdisciplinaire : on doit sélectionner une liste de cours donnée&#10;Regle metier : Durant les examens, ce sont les assistants qui notent&#10;Incertitude : « les cours ne sont pas organisés selon une structure suivie. Donc on peut un petit peu arranger les cours comme on veut »&#10;Incertitude : « c'est eux qui vont parfois noter les examens »&#10;Incertitude : « parfois il se peut que eux aussi corrigent les devoirs »&#10;Incertitude : En master « c'est à peu près pareil »"><mxCell parent="bpmn-L0" style="swimlane;html=1;childLayout=stackLayout;resizeParent=1;resizeParentMax=0;horizontal=0;startSize=24;horizontalStack=0;collapsible=0;fillColor=#F5F7F8;strokeColor=#67747C;fontColor=#2C3136;fontSize=11;fontStyle=1;" vertex="1"><mxGeometry height="744" width="3860" x="40" y="96" as="geometry"></mxGeometry></mxCell></object>
        <mxCell id="bpmn-lane_0" parent="bpmn-pool" style="swimlane;html=1;startSize=24;horizontal=0;collapsible=0;fillColor=none;strokeColor=#67747C;fontColor=#2C3136;fontSize=10;" value="Étudiant" vertex="1"><mxGeometry height="232" width="3836" x="24" y="0" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-lane_1" parent="bpmn-pool" style="swimlane;html=1;startSize=24;horizontal=0;collapsible=0;fillColor=none;strokeColor=#67747C;fontColor=#2C3136;fontSize=10;" value="Conseiller académique" vertex="1"><mxGeometry height="140" width="3836" x="24" y="232" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-lane_2" parent="bpmn-pool" style="swimlane;html=1;startSize=24;horizontal=0;collapsible=0;fillColor=none;strokeColor=#67747C;fontColor=#2C3136;fontSize=10;" value="Directrice de stage" vertex="1"><mxGeometry height="140" width="3836" x="24" y="372" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-lane_3" parent="bpmn-pool" style="swimlane;html=1;startSize=24;horizontal=0;collapsible=0;fillColor=none;strokeColor=#67747C;fontColor=#2C3136;fontSize=10;" value="Assistants" vertex="1"><mxGeometry height="232" width="3836" x="24" y="512" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-Start_1" parent="bpmn-lane_0" style="shape=mxgraph.bpmn.shape;html=1;perimeter=ellipsePerimeter;symbol=general;outline=standard;fillColor=#E4F2E9;strokeColor=#2F7D4F;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fontSize=9;fontColor=#2C3136;outlineConnect=0;whiteSpace=wrap;labelWidth=64;" value="L'étudiant s'inscrit à l'université" vertex="1"><mxGeometry height="36" width="36" x="44" y="32" as="geometry"></mxGeometry></mxCell>
        <object id="bpmn-Task_s1" label="Choisir le niveau et la filière d'inscription" tooltip="Donnees sortantes : Niveau d'études (bachelor ou master), Filière choisie&#10;Mode operatoire : Choisir d'abord entre master et bachelor, puis dans quel master ou quel bachelor s'inscrire"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="96" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s2" label="Orienter l'étudiant" tooltip="Donnees entrantes : Goûts de l'étudiant, Débouchés espérés&#10;Mode operatoire : Guider l'étudiant en fonction de ce qu'il aime, de ce qu'il n'aime pas et des débouchés qu'il espère&#10;Participants : Étudiant"><mxCell parent="bpmn-lane_1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="336" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s3" label="Choisir son orientation" tooltip="Donnees sortantes : Orientation choisie&#10;Mode operatoire : Orientation interdisciplinaire retenue ; également possibles : orientation économie et management, orientation art, orientation langue"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="576" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s4" label="Choisir ses cours" tooltip="Donnees entrantes : Nombre de crédits&#10;Donnees sortantes : Liste de cours choisis&#10;Mode operatoire : En orientation interdisciplinaire, choisir des cours dans toutes les facultés tant que le nombre de crédits est rempli"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="816" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s5" label="S'inscrire aux cours sur la plateforme" tooltip="Donnees entrantes : Liste de cours choisis&#10;Donnees sortantes : Inscription aux cours&#10;Outils : Moodle&#10;Mode operatoire : S'inscrire sur la plateforme puis parler au professeur"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="1056" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s6" label="Suivre les cours et rendre les travaux" tooltip="Documents sortants : Exercices rendus, Travaux notés&#10;Mode operatoire : Suivre les cours, rendre les exercices demandés et effectuer les travaux notés"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="1296" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s7" label="Passer la session d'examen" tooltip="Donnees sortantes : Résultat d'examen"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="1536" y="24" as="geometry"></mxGeometry></mxCell></object>
        <mxCell id="bpmn-Gw_s7" parent="bpmn-lane_0" style="shape=mxgraph.bpmn.shape;html=1;perimeter=rhombusPerimeter;background=gateway;outline=none;symbol=exclusiveGw;fillColor=#FFE6CC;strokeColor=#D79B00;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fontSize=9;fontColor=#2C3136;outlineConnect=0;" value="Session réussie ?" vertex="1"><mxGeometry height="44" width="44" x="1710" y="28" as="geometry"></mxGeometry></mxCell>
        <object id="bpmn-Task_s8" label="Passer la session de rattrapage" tooltip="Donnees sortantes : Résultat de rattrapage&#10;Duree : trois mois&#10;Frequence : en été"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="1776" y="24" as="geometry"></mxGeometry></mxCell></object>
        <mxCell id="bpmn-Gw_s8" parent="bpmn-lane_0" style="shape=mxgraph.bpmn.shape;html=1;perimeter=rhombusPerimeter;background=gateway;outline=none;symbol=exclusiveGw;fillColor=#FFE6CC;strokeColor=#D79B00;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fontSize=9;fontColor=#2C3136;outlineConnect=0;" value="Rattrapage réussi ?" vertex="1"><mxGeometry height="44" width="44" x="1950" y="28" as="geometry"></mxGeometry></mxCell>
        <object id="bpmn-Task_s9" label="Trouver un stage et ses encadrants" tooltip="Donnees sortantes : Encadrant académique, Encadrement en entreprise&#10;Mode operatoire : Trouver un stage, un professeur qui suit le stage et un encadrement en entreprise"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="2016" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s10" label="Accepter le stage" tooltip="Donnees sortantes : Acceptation du stage"><mxCell parent="bpmn-lane_2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="2256" y="24" as="geometry"></mxGeometry></mxCell></object>
        <mxCell id="bpmn-Gw_s10" parent="bpmn-lane_2" style="shape=mxgraph.bpmn.shape;html=1;perimeter=rhombusPerimeter;background=gateway;outline=none;symbol=exclusiveGw;fillColor=#FFE6CC;strokeColor=#D79B00;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fontSize=9;fontColor=#2C3136;outlineConnect=0;" value="Stage accepté ?" vertex="1"><mxGeometry height="44" width="44" x="2430" y="28" as="geometry"></mxGeometry></mxCell>
        <object id="bpmn-Task_s11" label="Réaliser le stage" tooltip="Donnees sortantes : Crédits obtenus&#10;Mode operatoire : Le stage se déroule durant le cursus, suivi par l'encadrant académique et l'encadrement en entreprise"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="2496" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s12" label="Décider du sujet de travail de bachelor" tooltip="Donnees sortantes : Sujet de travail de bachelor, Professeur encadrant&#10;Frequence : À la fin de la troisième année&#10;Mode operatoire : S'entretenir avec plusieurs professeurs jusqu'à ce qu'un professeur accepte de suivre le travail de bachelor&#10;Participants : Professeur"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="2736" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s13" label="Sélectionner les cours de master" tooltip="Donnees entrantes : Liste de cours donnée&#10;Donnees sortantes : Cours de master sélectionnés&#10;Mode operatoire : En master il n'y a pas d'orientation interdisciplinaire : sélectionner dans une liste de cours donnée"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="2976" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s14" label="Suivre les séances de travaux pratiques" tooltip="Frequence : chaque semaine&#10;Mode operatoire : Les moniteurs aident les étudiants durant les séances de travaux pratiques&#10;Participants : Moniteurs"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="3216" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s15" label="Corriger les devoirs et noter les examens" tooltip="Documents entrants : Devoirs&#10;Documents sortants : Notes&#10;Mode operatoire : Les assistants sont des doctorants ; ils corrigent les devoirs et notent les examens"><mxCell parent="bpmn-lane_3" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="3456" y="24" as="geometry"></mxGeometry></mxCell></object>
        <mxCell id="bpmn-End_main" parent="bpmn-lane_3" style="shape=mxgraph.bpmn.shape;html=1;perimeter=ellipsePerimeter;symbol=general;outline=end;fillColor=#FCE8E6;strokeColor=#B85450;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fontSize=9;fontColor=#2C3136;outlineConnect=0;whiteSpace=wrap;labelWidth=140;" value="Cours validés, travail de bachelor réalisé puis poursuite en master" vertex="1"><mxGeometry height="36" width="36" x="3738" y="124" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-End_no_s8" parent="bpmn-lane_0" style="shape=mxgraph.bpmn.shape;html=1;perimeter=ellipsePerimeter;symbol=general;outline=end;fillColor=#FCE8E6;strokeColor=#B85450;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fontSize=9;fontColor=#2C3136;outlineConnect=0;whiteSpace=wrap;labelWidth=140;" value="Élimination du bachelor si le cours est obligatoire, sinon deux autres tentatives" vertex="1"><mxGeometry height="36" width="36" x="2058" y="124" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-Ann_0" parent="bpmn-lane_1" style="shape=note;html=1;whiteSpace=wrap;size=12;fillColor=#F5F5F5;strokeColor=#9AA0A6;fontColor=#57606A;fontFamily=Arial,Helvetica,sans-serif;fontSize=8;align=left;spacingLeft=4;" value="Si on ne sait pas quoi choisir, on peut demander à un conseiller académique" vertex="1"><mxGeometry height="30" width="150" x="352" y="82" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-Ann_1" parent="bpmn-lane_0" style="shape=note;html=1;whiteSpace=wrap;size=12;fillColor=#F5F5F5;strokeColor=#9AA0A6;fontColor=#57606A;fontFamily=Arial,Helvetica,sans-serif;fontSize=8;align=left;spacingLeft=4;" value="Sinon on peut aussi faire un stage durant le cursus" vertex="1"><mxGeometry height="30" width="150" x="2032" y="82" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-Ann_2" parent="bpmn-lane_3" style="shape=note;html=1;whiteSpace=wrap;size=12;fillColor=#F5F5F5;strokeColor=#9AA0A6;fontColor=#57606A;fontFamily=Arial,Helvetica,sans-serif;fontSize=8;align=left;spacingLeft=4;" value="Parfois il se peut que les moniteurs aussi corrigent les devoirs" vertex="1"><mxGeometry height="30" width="150" x="3472" y="82" as="geometry"></mxGeometry></mxCell>
