        <object id="proc-card_10" label="Réaliser le stage" tooltip="Mode opératoire : Le stage se déroule durant le cursus, suivi par l'encadrant académique et l'encadrement en entreprise" source="Mode opératoire : Le stage se déroule durant le cursus, suivi par l'encadrant académique et l'encadrement en entreprise"><mxCell parent="proc-cell_0_10" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_11" label="Décider du sujet de travail de bachelor" tooltip="Mode opératoire : S'entretenir avec plusieurs professeurs jusqu'à ce qu'un professeur accepte de suivre le travail de bachelor" source="Mode opératoire : S'entretenir avec plusieurs professeurs jusqu'à ce qu'un professeur accepte de suivre le travail de bachelor"><mxCell parent="proc-cell_0_11" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_12" label="Sélectionner les cours de master" tooltip="Mode opératoire : En master il n'y a pas d'orientation interdisciplinaire : sélectionner dans une liste de cours donnée" source="Mode opératoire : En master il n'y a pas d'orientation interdisciplinaire : sélectionner dans une liste de cours donnée"><mxCell parent="proc-cell_0_12" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_13" label="Suivre les séances de travaux pratiques" tooltip="Mode opératoire : Les moniteurs aident les étudiants durant les séances de travaux pratiques" source="Mode opératoire : Les moniteurs aident les étudiants durant les séances de travaux pratiques"><mxCell parent="proc-cell_0_13" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
