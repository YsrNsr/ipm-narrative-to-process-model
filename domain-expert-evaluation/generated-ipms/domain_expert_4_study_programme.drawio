        <object id="proc-card_8" label="Trouver un stage et ses encadrants" tooltip="Mode opératoire : Trouver un stage, un professeur qui suit le stage et un encadrement en entreprise" source="Mode opératoire : Trouver un stage, un professeur qui suit le stage et un encadrement en entreprise"><mxCell parent="proc-cell_0_8" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
