        <mxCell id="bpmn-End_no_s4" parent="bpmn-lane_1" style="shape=mxgraph.bpmn.shape;html=1;perimeter=ellipsePerimeter;symbol=general;outline=end;fillColor=#FCE8E6;strokeColor=#B85450;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fontSize=9;fontColor=#2C3136;outlineConnect=0;whiteSpace=wrap;labelWidth=140;" value="Refuser l'enregistrement" vertex="1"><mxGeometry height="36" width="36" x="1098" y="124" as="geometry"></mxGeometry></mxCell>
