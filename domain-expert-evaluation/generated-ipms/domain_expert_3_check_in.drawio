        <object id="proc-card_9" label="Contacter le duty manager en cas de probleme" tooltip="Mode opératoire : Les duty managers indiquent comment faire et quelles procedures appliquer en cas de doute sur les procedures de l'aeroport" source="Mode opératoire : Les duty managers indiquent comment faire et quelles procedures appliquer en cas de doute sur les procedures de l'aeroport"><mxCell parent="proc-cell_1_9" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_10" label="Signaler un bagage mal achemine" tooltip="Mode opératoire : Contacter le manager des bagages pour lui demander de renvoyer le bagage ou de modifier le tag" source="Mode opératoire : Contacter le manager des bagages pour lui demander de renvoyer le bagage ou de modifier le tag"><mxCell parent="proc-cell_1_10" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
