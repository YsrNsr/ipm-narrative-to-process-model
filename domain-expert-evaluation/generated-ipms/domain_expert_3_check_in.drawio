        <object id="proc-card_0" label="Confectionner et distribuer les horaires" tooltip="Mode opératoire : Confectionner les shifts de facon equilibree entre early, early mid et late" source="Mode opératoire : Confectionner les shifts de facon equilibree entre early, early mid et late"><mxCell parent="proc-cell_0_0" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="30" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_1" label="Consulter son affectation dans l'aquarium" tooltip="Mode opératoire : Saisir son code de travailleur sur les ecrans pour connaitre de quelle heure a quelle heure etre a quel guichet" source="Mode opératoire : Saisir son code de travailleur sur les ecrans pour connaitre de quelle heure a quelle heure etre a quel guichet"><mxCell parent="proc-cell_1_1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_2" label="Rejoindre le guichet et attendre les passagers" tooltip="Mode opératoire : Deux types de guichets : guichets dedies a une compagnie pour un ou plusieurs vols, et guichets non dedies traitant plein de compagnies et de vols en parallele" source="Mode opératoire : Deux types de guichets : guichets dedies a une compagnie pour un ou plusieurs vols, et guichets non dedies traitant plein de compagnies et de vols en parallele"><mxCell parent="proc-cell_1_2" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_3" label="Verifier l'identite et les documents de voyage" tooltip="Mode opératoire : Demander le passeport et la destination, soit scanner le passeport soit ecrire le nom dans Altea, trouver la personne, verifier que c'est la bonne personne, que la destination est correcte et qu'il y a le visa" source="Mode opératoire : Demander le passeport et la destination, soit scanner le passeport soit ecrire le nom dans Altea, trouver la personne, verifier que c'est la bonne personne, que la destination est correcte et qu'il y a le visa"><mxCell parent="proc-cell_1_3" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="46" width="199" x="20" y="2" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-dec_3" label="Droit de voyager ?" tooltip="Droit de voyager ?" source="Droit de voyager ?"><mxCell parent="proc-cell_1_3" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;fontSize=8;" vertex="1"><mxGeometry height="70" width="70" x="80" y="54" as="geometry"></mxGeometry></mxCell></object>
