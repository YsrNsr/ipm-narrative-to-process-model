        <object id="proc-card_5" label="Notifier le supplement a payer" tooltip="Mode opératoire : Mettre une notification sur le systeme indiquant que la personne doit payer un supplement et lui remettre une petite feuille pour la caisse" source="Mode opératoire : Mettre une notification sur le systeme indiquant que la personne doit payer un supplement et lui remettre une petite feuille pour la caisse"><mxCell parent="proc-cell_1_5" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
