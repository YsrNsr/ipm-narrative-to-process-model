        <object id="proc-card_4" label="Peser et etiqueter les bagages" tooltip="Mode opératoire : Demander de poser les bagages, les peser, demander s'il n'y a rien d'electronique de dangereux, imprimer et poser le tag de destination puis envoyer le bagage" source="Mode opératoire : Demander de poser les bagages, les peser, demander s'il n'y a rien d'electronique de dangereux, imprimer et poser le tag de destination puis envoyer le bagage"><mxCell parent="proc-cell_1_4" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="46" width="199" x="20" y="2" as="geometry"></mxGeometry></mxCell></object>
