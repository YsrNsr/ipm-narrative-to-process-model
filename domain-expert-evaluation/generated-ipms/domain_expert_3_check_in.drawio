  <diagram id="bpmn" name="BPMN">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2980" pageHeight="688" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="bpmn-L0" parent="0" value="Processus" />
        <mxCell id="bpmn-note" parent="bpmn-L0" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#8A8F94;fontFamily=Arial,Helvetica,sans-serif;" value="Vue BPMN dérivée du MIP : parallélisme d'étage en passerelles ET, terminaisons et exceptions représentées ; décisions binaires ; la grille MIP reste la référence." vertex="1"><mxGeometry height="18" width="900" x="40" y="34" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-legend" parent="bpmn-L0" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#8A8F94;fontFamily=Arial,Helvetica,sans-serif;" value="Jaune : tâche humaine · Bleu : tâche automatisée · Vert : début · Rouge : fin · Orange : passerelle · Gris : annotation" vertex="1"><mxGeometry height="18" width="900" x="40" y="56" as="geometry"></mxGeometry></mxCell>
        <object id="bpmn-pool" label="Enregistrement et embarquement des passagers par l'agent d'escale" tooltip="Regle metier : Au-dela du poids autorise, on fait payer les kilos en trop&#10;Regle metier : S'il y a un bagage en trop, on fait payer le bagage en trop&#10;Regle metier : On demande pour chaque bagage s'il n'y a rien d'electronique de dangereux qui peut poser probleme&#10;Regle metier : Le paiement du supplement se fait a la caisse, pas au guichet&#10;Regle metier : Pour un passager avec un chien, on doit verifier que le chien a son passeport et que tout est en ordre&#10;Regle metier : Quand on pese les bagages, on doit imprimer et poser un tag indiquant la destination du bagage&#10;Regle metier : Les early peuvent commencer a 4h du matin&#10;Incertitude : « parfois le systeme decide automatiquement » l'attribution du siege&#10;Incertitude : « Sinon il peut nous arriver pas mal de choses »&#10;Incertitude : « il peut aussi arriver qu'on aille en gate »&#10;Incertitude : « on demande leur passeport et leur carte d'identite, on demande enfin juste leur passeport »"><mxCell parent="bpmn-L0" style="swimlane;html=1;childLayout=stackLayout;resizeParent=1;resizeParentMax=0;horizontal=0;startSize=24;horizontalStack=0;collapsible=0;fillColor=#F5F7F8;strokeColor=#67747C;fontColor=#2C3136;fontSize=11;fontStyle=1;" vertex="1"><mxGeometry height="512" width="2900" x="40" y="96" as="geometry"></mxGeometry></mxCell></object>
        <mxCell id="bpmn-lane_0" parent="bpmn-pool" style="swimlane;html=1;startSize=24;horizontal=0;collapsible=0;fillColor=none;strokeColor=#67747C;fontColor=#2C3136;fontSize=10;" value="Shift distributeur" vertex="1"><mxGeometry height="140" width="2876" x="24" y="0" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-lane_1" parent="bpmn-pool" style="swimlane;html=1;startSize=24;horizontal=0;collapsible=0;fillColor=none;strokeColor=#67747C;fontColor=#2C3136;fontSize=10;" value="Agent d'escale" vertex="1"><mxGeometry height="232" width="2876" x="24" y="140" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-lane_2" parent="bpmn-pool" style="swimlane;html=1;startSize=24;horizontal=0;collapsible=0;fillColor=none;strokeColor=#67747C;fontColor=#2C3136;fontSize=10;" value="Collaborateurs de la caisse" vertex="1"><mxGeometry height="140" width="2876" x="24" y="372" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-Start_1" parent="bpmn-lane_0" style="shape=mxgraph.bpmn.shape;html=1;perimeter=ellipsePerimeter;symbol=general;outline=standard;fillColor=#E4F2E9;strokeColor=#2F7D4F;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fontSize=9;fontColor=#2C3136;outlineConnect=0;whiteSpace=wrap;labelWidth=64;" value="Reception de l'horaire mensuel et prise du shift (early, early mid ou late)" vertex="1"><mxGeometry height="36" width="36" x="44" y="32" as="geometry"></mxGeometry></mxCell>
        <object id="bpmn-Task_s1" label="Confectionner et distribuer les horaires" tooltip="Documents sortants : Horaire mensuel&#10;Donnees sortantes : Heures de shift&#10;Frequence : Tous les mois&#10;Mode operatoire : Confectionner les shifts de facon equilibree entre early, early mid et late"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="96" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s2" label="Consulter son affectation dans l'aquarium" tooltip="Documents entrants : Horaire mensuel&#10;Donnees entrantes : Code de travailleur&#10;Donnees sortantes : Horaires, Guichet attribue&#10;Outils : Ecrans de l'aquarium&#10;Frequence : A chaque prise de service&#10;Mode operatoire : Saisir son code de travailleur sur les ecrans pour connaitre de quelle heure a quelle heure etre a quel guichet"><mxCell parent="bpmn-lane_1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="336" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s3" label="Rejoindre le guichet et attendre les passagers" tooltip="Donnees entrantes : Guichet attribue&#10;Mode operatoire : Deux types de guichets : guichets dedies a une compagnie pour un ou plusieurs vols, et guichets non dedies traitant plein de compagnies et de vols en parallele"><mxCell parent="bpmn-lane_1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="576" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s4" label="Verifier l'identite et les documents de voyage" tooltip="Documents entrants : Passeport, Visa&#10;Donnees entrantes : Nom du passager, Destination&#10;Outils : Altea&#10;Frequence : A chaque passager&#10;Mode operatoire : Demander le passeport et la destination, soit scanner le passeport soit ecrire le nom dans Altea, trouver la personne, verifier que c'est la bonne personne, que la destination est correcte et qu'il y a le visa"><mxCell parent="bpmn-lane_1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="816" y="24" as="geometry"></mxGeometry></mxCell></object>
        <mxCell id="bpmn-Gw_s4" parent="bpmn-lane_1" style="shape=mxgraph.bpmn.shape;html=1;perimeter=rhombusPerimeter;background=gateway;outline=none;symbol=exclusiveGw;fillColor=#FFE6CC;strokeColor=#D79B00;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fontSize=9;fontColor=#2C3136;outlineConnect=0;" value="Droit de voyager ?" vertex="1"><mxGeometry height="44" width="44" x="990" y="28" as="geometry"></mxGeometry></mxCell>
        <object id="bpmn-Task_s5" label="Peser et etiqueter les bagages" tooltip="Documents sortants : Tag bagage&#10;Donnees entrantes : Poids du bagage, Nombre de bagages&#10;Donnees sortantes : Destination du bagage&#10;Frequence : A chaque bagage&#10;Mode operatoire : Demander de poser les bagages, les peser, demander s'il n'y a rien d'electronique de dangereux, imprimer et poser le tag de destination puis envoyer le bagage"><mxCell parent="bpmn-lane_1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="1056" y="24" as="geometry"></mxGeometry></mxCell></object>
        <mxCell id="bpmn-Gw_s5" parent="bpmn-lane_1" style="shape=mxgraph.bpmn.shape;html=1;perimeter=rhombusPerimeter;background=gateway;outline=none;symbol=exclusiveGw;fillColor=#FFE6CC;strokeColor=#D79B00;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fontSize=9;fontColor=#2C3136;outlineConnect=0;" value="Bagage en ordre ?" vertex="1"><mxGeometry height="44" width="44" x="1230" y="28" as="geometry"></mxGeometry></mxCell>
        <object id="bpmn-Task_s6" label="Notifier le supplement a payer" tooltip="Documents sortants : Petite feuille pour la caisse&#10;Donnees entrantes : Montant du supplement&#10;Outils : Altea&#10;Frequence : Quand il y a un supplement&#10;Mode operatoire : Mettre une notification sur le systeme indiquant que la personne doit payer un supplement et lui remettre une petite feuille pour la caisse"><mxCell parent="bpmn-lane_1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="1296" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s7" label="Encaisser le supplement" tooltip="Documents entrants : Petite feuille pour la caisse&#10;Donnees entrantes : Montant du supplement&#10;Friction : « la caisse n'est pas au guichet » : le passager doit se deplacer pour payer"><mxCell parent="bpmn-lane_2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="1536" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s8" label="Attribuer le siege et imprimer la carte d'embarquement" tooltip="Documents sortants : Boarding pass&#10;Donnees entrantes : Preference de siege&#10;Donnees sortantes : Numero de siege&#10;Outils : Altea&#10;Frequence : A chaque passager&#10;Mode operatoire : Demander la preference de siege quand il y a le choix, sinon le systeme decide automatiquement selon la compagnie aerienne ; imprimer les boarding pass, indiquer les sieges et de quel cote la personne doit se diriger"><mxCell parent="bpmn-lane_1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="1776" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s9" label="Controler les cartes d'embarquement en gate" tooltip="Documents entrants : Boarding pass&#10;Donnees entrantes : Numero de vol&#10;Mode operatoire : Devant les passagers, verifier une deuxieme fois la carte d'embarquement et que ce soit bien la bonne personne qui prend le bon vol, puis les laisser entrer"><mxCell parent="bpmn-lane_1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="2016" y="24" as="geometry"></mxGeometry></mxCell></object>
        <mxCell id="bpmn-Gw_s9" parent="bpmn-lane_1" style="shape=mxgraph.bpmn.shape;html=1;perimeter=rhombusPerimeter;background=gateway;outline=none;symbol=exclusiveGw;fillColor=#FFE6CC;strokeColor=#D79B00;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fontSize=9;fontColor=#2C3136;outlineConnect=0;" value="Bonne personne, bon vol ?" vertex="1"><mxGeometry height="44" width="44" x="2190" y="28" as="geometry"></mxGeometry></mxCell>
        <object id="bpmn-Task_s10" label="Contacter le duty manager en cas de probleme" tooltip="Frequence : Quand on a un probleme ou un doute sur les procedures&#10;Friction : « quand on a des problemes et qu'on sait pas comment resoudre le probleme »&#10;Mode operatoire : Les duty managers indiquent comment faire et quelles procedures appliquer en cas de doute sur les procedures de l'aeroport&#10;Participants : Duty managers"><mxCell parent="bpmn-lane_1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="2256" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s11" label="Signaler un bagage mal achemine" tooltip="Documents entrants : Tag bagage&#10;Donnees entrantes : Destination du bagage&#10;Friction : Bagage envoye sur la mauvaise personne ou avec un mauvais tag — « on a envoye le bagage au mauvais endroit »&#10;Mode operatoire : Contacter le manager des bagages pour lui demander de renvoyer le bagage ou de modifier le tag&#10;Participants : Managers qui gerent les bagages"><mxCell parent="bpmn-lane_1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="2496" y="24" as="geometry"></mxGeometry></mxCell></object>
