        <object id="proc-card_7" label="Attribuer le siege et imprimer la carte d'embarquement" tooltip="Mode opératoire : Demander la preference de siege quand il y a le choix, sinon le systeme decide automatiquement selon la compagnie aerienne ; imprimer les boarding pass, indiquer les sieges et de quel cote la personne doit se diriger" source="Mode opératoire : Demander la preference de siege quand il y a le choix, sinon le systeme decide automatiquement selon la compagnie aerienne ; imprimer les boarding pass, indiquer les sieges et de quel cote la personne doit se diriger"><mxCell parent="proc-cell_1_7" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="59" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_8" label="Controler les cartes d'embarquement en gate" tooltip="Mode opératoire : Devant les passagers, verifier une deuxieme fois la carte d'embarquement et que ce soit bien la bonne personne qui prend le bon vol, puis les laisser entrer" source="Mode opératoire : Devant les passagers, verifier une deuxieme fois la carte d'embarquement et que ce soit bien la bonne personne qui prend le bon vol, puis les laisser entrer"><mxCell parent="proc-cell_1_8" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="46" width="199" x="20" y="2" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-dec_8" label="Bonne personne, bon vol ?" tooltip="Bonne personne, bon vol ?" source="Bonne personne, bon vol ?"><mxCell parent="proc-cell_1_8" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;fontSize=8;" vertex="1"><mxGeometry height="70" width="70" x="80" y="54" as="geometry"></mxGeometry></mxCell></object>
