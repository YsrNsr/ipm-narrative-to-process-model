        <object id="maki_mo_r0_c2" label="Organiser un entretien avec chaque candidat pour voir s'ils sont éligibles, si leur projet fait sens, et revoir les documents et cartes d'identité déposés" tooltip="l.1 : Donc bonjour, moi je suis conseillère pour un programme d'accès à l'université, c'est un programme de réinsertion pour les migrants, réinsertion académique po…" source="l.1 : Donc bonjour, moi je suis conseillère pour un programme d'accès à l'université, c'est un programme de réinsertion pour les migrants, réinsertion académique po…"><mxCell parent="maki_mo_r0" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFFF;top=0;left=0;bottom=1;right=1;pointerEvents=1;fontFamily=Arial,Helvetica,sans-serif;fontSize=8;fontColor=#2C3136;align=left;verticalAlign=top;spacingLeft=6;" vertex="1"><mxGeometry height="72" width="235" x="685" y="0" as="geometry"></mxGeometry></mxCell></object>
        <object id="maki_mo_r0_c3" label="Choisir tous les candidats qui sont éligibles et qui ont des projets concrets qui peuvent se réaliser, selon plusieurs critères" tooltip="l.1 : Donc bonjour, moi je suis conseillère pour un programme d'accès à l'université, c'est un programme de réinsertion pour les migrants, réinsertion académique po…" source="l.1 : Donc bonjour, moi je suis conseillère pour un programme d'accès à l'université, c'est un programme de réinsertion pour les migrants, réinsertion académique po…"><mxCell parent="maki_mo_r0" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFFF;top=0;left=0;bottom=1;right=1;pointerEvents=1;fontFamily=Arial,Helvetica,sans-serif;fontSize=8;fontColor=#2C3136;align=left;verticalAlign=top;spacingLeft=6;" vertex="1"><mxGeometry height="72" width="235" x="920" y="0" as="geometry"></mxGeometry></mxCell></object>
        <object id="maki_mo_r0_c4" label="Le comité académique valide les candidats, demande un deuxième round d'entretien pour certains, ou en refuse" tooltip="l.1 : Donc bonjour, moi je suis conseillère pour un programme d'accès à l'université, c'est un programme de réinsertion pour les migrants, réinsertion académique po…" source="l.1 : Donc bonjour, moi je suis conseillère pour un programme d'accès à l'université, c'est un programme de réinsertion pour les migrants, réinsertion académique po…"><mxCell parent="maki_mo_r0" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFFF;top=0;left=0;bottom=1;right=1;pointerEvents=1;fontFamily=Arial,Helvetica,sans-serif;fontSize=8;fontColor=#2C3136;align=left;verticalAlign=top;spacingLeft=6;" vertex="1"><mxGeometry height="72" width="235" x="1155" y="0" as="geometry"></mxGeometry></mxCell></object>
