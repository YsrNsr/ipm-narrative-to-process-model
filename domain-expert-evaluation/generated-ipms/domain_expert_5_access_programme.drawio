        <object id="bpmn-Task_s6" label="Faire passer le candidat au statut de participant" tooltip="Documents entrants : Liste de candidats acceptés&#10;Donnees entrantes : Statut de candidat&#10;Donnees sortantes : Statut de participant"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="1296" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s7" label="Attribuer un mentor au participant" tooltip="Donnees sortantes : Nom du mentor attribué&#10;Mode operatoire : Chaque candidat a un mentor qui va un petit peu les aider"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="1536" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s8" label="Suivre les cours de français" tooltip="Donnees sortantes : Niveau de langue&#10;Mode operatoire : Suivre des cours de français pour atteindre un niveau permettant de suivre les cours à l'université"><mxCell parent="bpmn-lane_3" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="1776" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s9" label="Passer les certifications de langue" tooltip="Documents sortants : Certification de niveau de langue&#10;Donnees entrantes : Niveau de langue&#10;Donnees sortantes : Niveau certifié (B1, B2, C1)&#10;Mode operatoire : Passer les certifications pour passer de B1 à B2, puis C1"><mxCell parent="bpmn-lane_3" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="2016" y="24" as="geometry"></mxGeometry></mxCell></object>
