        <object id="maki_mo_r0_c6" label="Chaque candidat a un mentor qui va un petit peu les aider" tooltip="l.1 : Donc bonjour, moi je suis conseillère pour un programme d'accès à l'université, c'est un programme de réinsertion pour les migrants, réinsertion académique po…" source="l.1 : Donc bonjour, moi je suis conseillère pour un programme d'accès à l'université, c'est un programme de réinsertion pour les migrants, réinsertion académique po…"><mxCell parent="maki_mo_r0" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFFF;top=0;left=0;bottom=1;right=1;pointerEvents=1;fontFamily=Arial,Helvetica,sans-serif;fontSize=8;fontColor=#2C3136;align=left;verticalAlign=top;spacingLeft=6;" vertex="1"><mxGeometry height="72" width="235" x="1625" y="0" as="geometry"></mxGeometry></mxCell></object>
        <object id="maki_mo_r0_c7" label="Suivre des cours de français pour atteindre un niveau permettant de suivre les cours à l'université" tooltip="l.1 : Donc bonjour, moi je suis conseillère pour un programme d'accès à l'université, c'est un programme de réinsertion pour les migrants, réinsertion académique po…" source="l.1 : Donc bonjour, moi je suis conseillère pour un programme d'accès à l'université, c'est un programme de réinsertion pour les migrants, réinsertion académique po…"><mxCell parent="maki_mo_r0" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFFF;top=0;left=0;bottom=1;right=1;pointerEvents=1;fontFamily=Arial,Helvetica,sans-serif;fontSize=8;fontColor=#2C3136;align=left;verticalAlign=top;spacingLeft=6;" vertex="1"><mxGeometry height="72" width="235" x="1860" y="0" as="geometry"></mxGeometry></mxCell></object>
        <object id="maki_mo_r0_c8" label="Passer les certifications pour passer de B1 à B2, puis C1" tooltip="l.1 : Donc bonjour, moi je suis conseillère pour un programme d'accès à l'université, c'est un programme de réinsertion pour les migrants, réinsertion académique po…" source="l.1 : Donc bonjour, moi je suis conseillère pour un programme d'accès à l'université, c'est un programme de réinsertion pour les migrants, réinsertion académique po…"><mxCell parent="maki_mo_r0" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFFF;top=0;left=0;bottom=1;right=1;pointerEvents=1;fontFamily=Arial,Helvetica,sans-serif;fontSize=8;fontColor=#2C3136;align=left;verticalAlign=top;spacingLeft=6;" vertex="1"><mxGeometry height="72" width="235" x="2095" y="0" as="geometry"></mxGeometry></mxCell></object>
        <object id="maki_mo_r0_c9" label="Avec un niveau B2, le participant peut participer à certains cours de l'université" tooltip="l.1 : Donc bonjour, moi je suis conseillère pour un programme d'accès à l'université, c'est un programme de réinsertion pour les migrants, réinsertion académique po…" source="l.1 : Donc bonjour, moi je suis conseillère pour un programme d'accès à l'université, c'est un programme de réinsertion pour les migrants, réinsertion académique po…"><mxCell parent="maki_mo_r0" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFFF;top=0;left=0;bottom=1;right=1;pointerEvents=1;fontFamily=Arial,Helvetica,sans-serif;fontSize=8;fontColor=#2C3136;align=left;verticalAlign=top;spacingLeft=6;" vertex="1"><mxGeometry height="72" width="235" x="2330" y="0" as="geometry"></mxGeometry></mxCell></object>
