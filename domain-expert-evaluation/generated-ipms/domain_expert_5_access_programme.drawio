  <diagram id="bpmn" name="BPMN">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3700" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="bpmn-L0" parent="0" value="Processus" />
        <mxCell id="bpmn-note" parent="bpmn-L0" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#8A8F94;fontFamily=Arial,Helvetica,sans-serif;" value="Vue BPMN dérivée du MIP : parallélisme d'étage en passerelles ET, terminaisons et exceptions représentées ; décisions binaires ; la grille MIP reste la référence." vertex="1"><mxGeometry height="18" width="900" x="40" y="34" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-legend" parent="bpmn-L0" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#8A8F94;fontFamily=Arial,Helvetica,sans-serif;" value="Jaune : tâche humaine · Bleu : tâche automatisée · Vert : début · Rouge : fin · Orange : passerelle · Gris : annotation" vertex="1"><mxGeometry height="18" width="900" x="40" y="56" as="geometry"></mxGeometry></mxCell>
        <object id="bpmn-pool" label="Programme universitaire d'accès aux études" tooltip="Regle metier : La liste des candidats présélectionnés doit être présentée au comité académique, qui valide, demande un deuxième round d'entretiens ou refuse&#10;Regle metier : Un candidat accepté passe du statut de candidat à celui de participant&#10;Regle metier : Chaque candidat a un mentor qui va un petit peu les aider&#10;Regle metier : Le participant peut participer à certains cours de l'université dès qu'il a un niveau B2&#10;Regle metier : Le participant fait partie du programme durant tout son cursus universitaire, jusqu'à l'obtention du bachelor et du master&#10;Regle metier : En cas d'échec académique, le participant sort automatiquement du programme&#10;Incertitude : « ça dépend aussi si le participant veut étudier en français ou en anglais »&#10;Incertitude : « chaque candidat a un mentor qui va un petit peu les aider »&#10;Incertitude : « pardon, j'avais dit participants, mais en fait c'est des candidats »"><mxCell parent="bpmn-L0" style="swimlane;html=1;childLayout=stackLayout;resizeParent=1;resizeParentMax=0;horizontal=0;startSize=24;horizontalStack=0;collapsible=0;fillColor=#F5F7F8;strokeColor=#67747C;fontColor=#2C3136;fontSize=11;fontStyle=1;" vertex="1"><mxGeometry height="884" width="3620" x="40" y="96" as="geometry"></mxGeometry></mxCell></object>
        <mxCell id="bpmn-lane_0" parent="bpmn-pool" style="swimlane;html=1;startSize=24;horizontal=0;collapsible=0;fillColor=none;strokeColor=#67747C;fontColor=#2C3136;fontSize=10;" value="Conseillère" vertex="1"><mxGeometry height="232" width="3596" x="24" y="0" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-lane_1" parent="bpmn-pool" style="swimlane;html=1;startSize=24;horizontal=0;collapsible=0;fillColor=none;strokeColor=#67747C;fontColor=#2C3136;fontSize=10;" value="Candidat" vertex="1"><mxGeometry height="140" width="3596" x="24" y="232" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-lane_2" parent="bpmn-pool" style="swimlane;html=1;startSize=24;horizontal=0;collapsible=0;fillColor=none;strokeColor=#67747C;fontColor=#2C3136;fontSize=10;" value="Comité académique" vertex="1"><mxGeometry height="140" width="3596" x="24" y="372" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-lane_3" parent="bpmn-pool" style="swimlane;html=1;startSize=24;horizontal=0;collapsible=0;fillColor=none;strokeColor=#67747C;fontColor=#2C3136;fontSize=10;" value="Participant" vertex="1"><mxGeometry height="232" width="3596" x="24" y="512" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-lane_4" parent="bpmn-pool" style="swimlane;html=1;startSize=24;horizontal=0;collapsible=0;fillColor=none;strokeColor=#67747C;fontColor=#2C3136;fontSize=10;" value="Mentor" vertex="1"><mxGeometry height="140" width="3596" x="24" y="744" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-Start_1" parent="bpmn-lane_0" style="shape=mxgraph.bpmn.shape;html=1;perimeter=ellipsePerimeter;symbol=general;outline=standard;fillColor=#E4F2E9;strokeColor=#2F7D4F;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fontSize=9;fontColor=#2C3136;outlineConnect=0;whiteSpace=wrap;labelWidth=64;" value="Ouverture des candidatures à une date précise" vertex="1"><mxGeometry height="36" width="36" x="44" y="32" as="geometry"></mxGeometry></mxCell>
        <object id="bpmn-Task_s1" label="Ouvrir les candidatures" tooltip="Donnees entrantes : Date d'ouverture des candidatures&#10;Mode operatoire : Les candidatures s'ouvrent à une date précise"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="96" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s2" label="Déposer sa candidature" tooltip="Documents sortants : Dossier de candidature, Carte d'identité&#10;Donnees sortantes : Projet académique"><mxCell parent="bpmn-lane_1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="336" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s3" label="Mener l'entretien de candidature" tooltip="Documents entrants : Dossier de candidature, Carte d'identité&#10;Donnees entrantes : Projet académique, Motivation à étudier à l'Université&#10;Frequence : À chaque candidat&#10;Mode operatoire : Organiser un entretien avec chaque candidat pour voir s'ils sont éligibles, si leur projet fait sens, et revoir les documents et cartes d'identité déposés&#10;Participants : Candidat"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="576" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s4" label="Établir la présélection" tooltip="Documents entrants : Dossier de candidature&#10;Documents sortants : Liste de candidats présélectionnés&#10;Donnees entrantes : Critères d'éligibilité&#10;Mode operatoire : Choisir tous les candidats qui sont éligibles et qui ont des projets concrets qui peuvent se réaliser, selon plusieurs critères"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="816" y="24" as="geometry"></mxGeometry></mxCell></object>
        <mxCell id="bpmn-Gw_s4" parent="bpmn-lane_0" style="shape=mxgraph.bpmn.shape;html=1;perimeter=rhombusPerimeter;background=gateway;outline=none;symbol=exclusiveGw;fillColor=#FFE6CC;strokeColor=#D79B00;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fontSize=9;fontColor=#2C3136;outlineConnect=0;" value="Candidat éligible ?" vertex="1"><mxGeometry height="44" width="44" x="990" y="28" as="geometry"></mxGeometry></mxCell>
        <object id="bpmn-Task_s5" label="Valider les candidats" tooltip="Documents entrants : Liste de candidats présélectionnés&#10;Documents sortants : Liste de candidats acceptés&#10;Mode operatoire : Le comité académique valide les candidats, demande un deuxième round d'entretien pour certains, ou en refuse"><mxCell parent="bpmn-lane_2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="1056" y="24" as="geometry"></mxGeometry></mxCell></object>
