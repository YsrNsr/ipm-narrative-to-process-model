        <object id="maki_mo_r0_c0" label="Les candidatures s'ouvrent à une date précise" tooltip="l.1 : Donc bonjour, moi je suis conseillère pour un programme d'accès à l'université, c'est un programme de réinsertion pour les migrants, réinsertion académique po…" source="l.1 : Donc bonjour, moi je suis conseillère pour un programme d'accès à l'université, c'est un programme de réinsertion pour les migrants, réinsertion académique po…"><mxCell parent="maki_mo_r0" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#FFFFFF;top=0;left=0;bottom=1;right=1;pointerEvents=1;fontFamily=Arial,Helvetica,sans-serif;fontSize=8;fontColor=#2C3136;align=left;verticalAlign=top;spacingLeft=6;" vertex="1"><mxGeometry height="72" width="235" x="215" y="0" as="geometry"></mxGeometry></mxCell></object>
