  <diagram id="bpmn" name="BPMN">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2740" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="bpmn-L0" parent="0" value="Processus" />
        <mxCell id="bpmn-note" parent="bpmn-L0" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#8A8F94;fontFamily=Arial,Helvetica,sans-serif;" value="Vue BPMN dérivée du MIP : parallélisme d'étage en passerelles ET, terminaisons et exceptions représentées ; décisions binaires ; la grille MIP reste la référence." vertex="1"><mxGeometry height="18" width="900" x="40" y="34" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-legend" parent="bpmn-L0" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#8A8F94;fontFamily=Arial,Helvetica,sans-serif;" value="Jaune : tâche humaine · Bleu : tâche automatisée · Vert : début · Rouge : fin · Orange : passerelle · Gris : annotation" vertex="1"><mxGeometry height="18" width="900" x="40" y="56" as="geometry"></mxGeometry></mxCell>
        <object id="bpmn-pool" label="Vente de chaussures en magasin de sport" tooltip="Regle metier : Toutes les boîtes de chaussures sont dans le sous-sol&#10;Regle metier : Si une personne regarde une chaussure, un des conseillers doit aller vers lui&#10;Regle metier : La caissière met le nom de la personne qui a vendu la chaussure lors de l'encaissement&#10;Regle metier : La personne peut gagner jusqu'à 1 % de tout ce qu'elle vend (pour une paire à 200 francs, une commission de 2 francs)"><mxCell parent="bpmn-L0" style="swimlane;html=1;childLayout=stackLayout;resizeParent=1;resizeParentMax=0;horizontal=0;startSize=24;horizontalStack=0;collapsible=0;fillColor=#F5F7F8;strokeColor=#67747C;fontColor=#2C3136;fontSize=11;fontStyle=1;" vertex="1"><mxGeometry height="884" width="2660" x="40" y="96" as="geometry"></mxGeometry></mxCell></object>
        <mxCell id="bpmn-lane_0" parent="bpmn-pool" style="swimlane;html=1;startSize=24;horizontal=0;collapsible=0;fillColor=none;strokeColor=#67747C;fontColor=#2C3136;fontSize=10;" value="Conseiller de vente à l'accueil" vertex="1"><mxGeometry height="140" width="2636" x="24" y="0" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-lane_1" parent="bpmn-pool" style="swimlane;html=1;startSize=24;horizontal=0;collapsible=0;fillColor=none;strokeColor=#67747C;fontColor=#2C3136;fontSize=10;" value="Conseiller de vente" vertex="1"><mxGeometry height="232" width="2636" x="24" y="140" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-lane_2" parent="bpmn-pool" style="swimlane;html=1;startSize=24;horizontal=0;collapsible=0;fillColor=none;strokeColor=#67747C;fontColor=#2C3136;fontSize=10;" value="Personne du stock" vertex="1"><mxGeometry height="140" width="2636" x="24" y="372" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-lane_3" parent="bpmn-pool" style="swimlane;html=1;startSize=24;horizontal=0;collapsible=0;fillColor=none;strokeColor=#67747C;fontColor=#2C3136;fontSize=10;" value="Client" vertex="1"><mxGeometry height="140" width="2636" x="24" y="512" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-lane_4" parent="bpmn-pool" style="swimlane;html=1;startSize=24;horizontal=0;collapsible=0;fillColor=none;strokeColor=#67747C;fontColor=#2C3136;fontSize=10;" value="Caissière" vertex="1"><mxGeometry height="232" width="2636" x="24" y="652" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-Start_1" parent="bpmn-lane_0" style="shape=mxgraph.bpmn.shape;html=1;perimeter=ellipsePerimeter;symbol=general;outline=standard;fillColor=#E4F2E9;strokeColor=#2F7D4F;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fontSize=9;fontColor=#2C3136;outlineConnect=0;whiteSpace=wrap;labelWidth=64;" value="Un client regarde une chaussure en surface de vente" vertex="1"><mxGeometry height="36" width="36" x="44" y="32" as="geometry"></mxGeometry></mxCell>
        <object id="bpmn-Task_s1" label="Surveiller la surface de vente" tooltip="Mode operatoire : Rester à l'accueil avec une vue sur tout le magasin, repérer les personnes en train de regarder des chaussures et dire s'il faut aller vers elles"><mxCell parent="bpmn-lane_0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="96" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s2" label="Aborder le client" tooltip="Donnees sortantes : Pointure souhaitée&#10;Frequence : À chaque client qui regarde une chaussure&#10;Mode operatoire : Aller vers le client, lui demander si tout va bien et s'il a besoin d'une pointure"><mxCell parent="bpmn-lane_1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="336" y="24" as="geometry"></mxGeometry></mxCell></object>
        <mxCell id="bpmn-Gw_s2" parent="bpmn-lane_1" style="shape=mxgraph.bpmn.shape;html=1;perimeter=rhombusPerimeter;background=gateway;outline=none;symbol=exclusiveGw;fillColor=#FFE6CC;strokeColor=#D79B00;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fontSize=9;fontColor=#2C3136;outlineConnect=0;" value="Besoin d'une pointure ?" vertex="1"><mxGeometry height="44" width="44" x="510" y="28" as="geometry"></mxGeometry></mxCell>
        <object id="bpmn-Task_s3" label="Demander la paire au stock" tooltip="Donnees entrantes : Code couleur de la chaussure, Marque, Pointure&#10;Outils : Walkie-talkie&#10;Mode operatoire : Appeler au walkie-talkie la personne du stock en bas en lui donnant le code couleur de la chaussure, la marque et la pointure"><mxCell parent="bpmn-lane_1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="576" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s4" label="Chercher et monter la chaussure" tooltip="Documents sortants : Boîte de chaussures&#10;Donnees entrantes : Code couleur de la chaussure, Marque, Pointure&#10;Outils : Walkie-talkie&#10;Mode operatoire : Aller chercher la chaussure au sous-sol, la monter en haut par les escaliers et prévenir le conseiller de vente quand elle est en haut"><mxCell parent="bpmn-lane_2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="816" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s5" label="Faire essayer la paire au client" tooltip="Documents entrants : Boîte de chaussures&#10;Mode operatoire : Récupérer la chaussure montée par le stock et la faire essayer au client"><mxCell parent="bpmn-lane_1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="1056" y="24" as="geometry"></mxGeometry></mxCell></object>
        <mxCell id="bpmn-Gw_s5" parent="bpmn-lane_1" style="shape=mxgraph.bpmn.shape;html=1;perimeter=rhombusPerimeter;background=gateway;outline=none;symbol=exclusiveGw;fillColor=#FFE6CC;strokeColor=#D79B00;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fontSize=9;fontColor=#2C3136;outlineConnect=0;" value="Client garde la paire ?" vertex="1"><mxGeometry height="44" width="44" x="1230" y="28" as="geometry"></mxGeometry></mxCell>
        <object id="bpmn-Task_s6" label="Proposer des articles complémentaires" tooltip="Mode operatoire : Demander au client s'il a des chaussettes, s'il a besoin d'un spray imperméabilisant, etc.&#10;Opportunite : « pour vendre un petit peu du bonus »"><mxCell parent="bpmn-lane_1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="1296" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s7" label="Apposer le sticker vendeur sur la boîte" tooltip="Documents entrants : Boîte de chaussures&#10;Documents sortants : Sticker avec le nom du vendeur&#10;Donnees sortantes : Nom du vendeur&#10;Mode operatoire : Mettre un petit sticker sur la boîte avec son nom, ce qui permet de savoir qui a vendu combien de chaussures"><mxCell parent="bpmn-lane_1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="1536" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s8" label="Déposer la paire à la caisse" tooltip="Documents entrants : Boîte de chaussures, Sticker avec le nom du vendeur&#10;Mode operatoire : Ramener la paire à la caisse et l'y laisser"><mxCell parent="bpmn-lane_1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="1776" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s9" label="Faire la queue et annoncer sa paire" tooltip="Mode operatoire : Attendre son tour dans la queue puis dire à la caisse la paire qu'il a"><mxCell parent="bpmn-lane_3" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="2016" y="24" as="geometry"></mxGeometry></mxCell></object>
        <object id="bpmn-Task_s10" label="Encaisser la paire" tooltip="Documents entrants : Boîte de chaussures, Sticker avec le nom du vendeur&#10;Documents sortants : Ticket de caisse&#10;Donnees entrantes : Nom du vendeur, Prix de la paire&#10;Donnees sortantes : Nombre de chaussures vendues par le vendeur, Montant vendu par le vendeur&#10;Outils : Caisse&#10;Mode operatoire : Encaisser la paire en saisissant le nom de la personne qui a vendu la chaussure, ce qui permet de suivre combien de chaussures elle a vendu et pour combien"><mxCell parent="bpmn-lane_4" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=10;" vertex="1"><mxGeometry height="52" width="150" x="2256" y="24" as="geometry"></mxGeometry></mxCell></object>
        <mxCell id="bpmn-End_main" parent="bpmn-lane_4" style="shape=mxgraph.bpmn.shape;html=1;perimeter=ellipsePerimeter;symbol=general;outline=end;fillColor=#FCE8E6;strokeColor=#B85450;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fontSize=9;fontColor=#2C3136;outlineConnect=0;whiteSpace=wrap;labelWidth=140;" value="La paire est encaissée et la vente attribuée au vendeur, ou la chaussure est rangée au stock" vertex="1"><mxGeometry height="36" width="36" x="2538" y="124" as="geometry"></mxGeometry></mxCell>
        <mxCell id="bpmn-End_no_s2" parent="bpmn-lane_1" style="shape=mxgraph.bpmn.shape;html=1;perimeter=ellipsePerimeter;symbol=general;outline=end;fillColor=#FCE8E6;strokeColor=#B85450;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fontSize=9;fontColor=#2C3136;outlineConnect=0;whiteSpace=wrap;labelWidth=140;" value="Laisser le client poursuivre sa visite" vertex="1"><mxGeometry height="36" width="36" x="618" y="124" as="geometry"></mxGeometry></mxCell>
