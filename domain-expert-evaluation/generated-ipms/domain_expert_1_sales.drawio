        <object id="proc-card_0" label="Surveiller la surface de vente" tooltip="Mode opératoire : Rester à l'accueil avec une vue sur tout le magasin, repérer les personnes en train de regarder des chaussures et dire s'il faut aller vers elles" source="Mode opératoire : Rester à l'accueil avec une vue sur tout le magasin, repérer les personnes en train de regarder des chaussures et dire s'il faut aller vers elles"><mxCell parent="proc-cell_0_0" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="30" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_1" label="Aborder le client" tooltip="Mode opératoire : Aller vers le client, lui demander si tout va bien et s'il a besoin d'une pointure" source="Mode opératoire : Aller vers le client, lui demander si tout va bien et s'il a besoin d'une pointure"><mxCell parent="proc-cell_1_1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="46" width="199" x="20" y="2" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-dec_1" label="Besoin d'une pointure ?" tooltip="Besoin d'une pointure ?" source="Besoin d'une pointure ?"><mxCell parent="proc-cell_1_1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;fontSize=8;" vertex="1"><mxGeometry height="70" width="70" x="80" y="54" as="geometry"></mxGeometry></mxCell></object>
        <mxCell id="proc-declink_1" parent="proc-L0" style="html=1;endArrow=block;endFill=1;strokeColor=#8A6D00;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="" edge="1" source="proc-card_1" target="proc-dec_1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <object id="proc-card_2" label="Demander la paire au stock" tooltip="Mode opératoire : Appeler au walkie-talkie la personne du stock en bas en lui donnant le code couleur de la chaussure, la marque et la pointure" source="Mode opératoire : Appeler au walkie-talkie la personne du stock en bas en lui donnant le code couleur de la chaussure, la marque et la pointure"><mxCell parent="proc-cell_1_2" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_3" label="Chercher et monter la chaussure" tooltip="Mode opératoire : Aller chercher la chaussure au sous-sol, la monter en haut par les escaliers et prévenir le conseiller de vente quand elle est en haut" source="Mode opératoire : Aller chercher la chaussure au sous-sol, la monter en haut par les escaliers et prévenir le conseiller de vente quand elle est en haut"><mxCell parent="proc-cell_2_3" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="30" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_4" label="Faire essayer la paire au client" tooltip="Mode opératoire : Récupérer la chaussure montée par le stock et la faire essayer au client" source="Mode opératoire : Récupérer la chaussure montée par le stock et la faire essayer au client"><mxCell parent="proc-cell_1_4" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="46" width="199" x="20" y="2" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-dec_4" label="Client garde la paire ?" tooltip="Client garde la paire ?" source="Client garde la paire ?"><mxCell parent="proc-cell_1_4" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;fontSize=8;" vertex="1"><mxGeometry height="70" width="70" x="80" y="54" as="geometry"></mxGeometry></mxCell></object>
        <mxCell id="proc-declink_4" parent="proc-L0" style="html=1;endArrow=block;endFill=1;strokeColor=#8A6D00;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="" edge="1" source="proc-card_4" target="proc-dec_4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <object id="proc-card_5" label="Proposer des articles complémentaires" tooltip="Mode opératoire : Demander au client s'il a des chaussettes, s'il a besoin d'un spray imperméabilisant, etc." source="Mode opératoire : Demander au client s'il a des chaussettes, s'il a besoin d'un spray imperméabilisant, etc."><mxCell parent="proc-cell_1_5" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_6" label="Apposer le sticker vendeur sur la boîte" tooltip="Mode opératoire : Mettre un petit sticker sur la boîte avec son nom, ce qui permet de savoir qui a vendu combien de chaussures" source="Mode opératoire : Mettre un petit sticker sur la boîte avec son nom, ce qui permet de savoir qui a vendu combien de chaussures"><mxCell parent="proc-cell_1_6" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_7" label="Déposer la paire à la caisse" tooltip="Mode opératoire : Ramener la paire à la caisse et l'y laisser" source="Mode opératoire : Ramener la paire à la caisse et l'y laisser"><mxCell parent="proc-cell_1_7" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="40" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_8" label="Faire la queue et annoncer sa paire" tooltip="Mode opératoire : Attendre son tour dans la queue puis dire à la caisse la paire qu'il a" source="Mode opératoire : Attendre son tour dans la queue puis dire à la caisse la paire qu'il a"><mxCell parent="proc-cell_3_8" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="30" as="geometry"></mxGeometry></mxCell></object>
        <object id="proc-card_9" label="Encaisser la paire" tooltip="Mode opératoire : Encaisser la paire en saisissant le nom de la personne qui a vendu la chaussure, ce qui permet de suivre combien de chaussures elle a vendu et pour combien" source="Mode opératoire : Encaisser la paire en saisissant le nom de la personne qui a vendu la chaussure, ce qui permet de suivre combien de chaussures elle a vendu et pour combien"><mxCell parent="proc-cell_4_9" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#E0B400;fontColor=#2C3136;fontFamily=Arial,Helvetica,sans-serif;fontSize=9;align=center;verticalAlign=middle;shadow=1;" vertex="1"><mxGeometry height="54" width="199" x="20" y="30" as="geometry"></mxGeometry></mxCell></object>
